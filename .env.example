# Salin file ini jadi `.env` lalu isi nilainya. Jangan pernah commit `.env`.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Kunci ini menembus semua RLS. Hanya dipakai di server (cron/backfill).
SUPABASE_SERVICE_ROLE_KEY=

# TrackSolid — akun GPS armada
TRACKSOLID_ACCOUNT=
TRACKSOLID_PASSWORD=

# OpenRouteService — perhitungan rute job
OPENROUTESERVICE_API_KEY=
