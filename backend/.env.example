# Supabase — Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Menembus semua RLS — hanya untuk cron, snapshot mileage, dan push notification. Jangan dikirim ke browser.
SUPABASE_SERVICE_ROLE_KEY=
# Schema tabel aplikasi; harus terdaftar di Data API → Exposed schemas.
SUPABASE_DB_SCHEMA=transport

# Integrasi eksternal
TRACKSOLID_ACCOUNT=
TRACKSOLID_PASSWORD=
OPENROUTESERVICE_API_KEY=

# Rahasia endpoint cron (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Push notification ke aplikasi driver (Firebase Cloud Messaging).
# Path berkas service-account JSON dari Firebase Console. Kosong = push nonaktif.
FIREBASE_CREDENTIALS_FILE=

# URL frontend (tautan reset password) & origin yang boleh memanggil API
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
